  "worked_cases": [
    {
      "id": "case-decoupling-placement",
      "description": "A 0.2 mm dielectric, 0.3 mm trace, 10 mm capacitor distance and 1 mm via length gives a 22 mm loop and a placement factor of 11 versus the adjacent position.",
      "inputs": [
        {
          "name": "dielectric_height",
          "value": 0.0002,
          "unit": "m",
          "note": null
        },
        {
          "name": "trace_width",
          "value": 0.0003,
          "unit": "m",
          "note": null
        },
        {
          "name": "capacitor_distance",
          "value": 0.01,
          "unit": "m",
          "note": null
        },
        {
          "name": "via_length",
          "value": 0.001,
          "unit": "m",
          "note": null
        }
      ],
      "expected": [
        {
          "name": "loop_inductance",
          "value": 1.843067690106012e-08,
          "unit": "H",
          "tolerance": 1e-20,
          "note": null
        },
        {
          "name": "placement_factor",
          "value": 11.0,
          "unit": "1",
          "tolerance": 1e-9,
          "note": null
        }
      ],
      "provenance": {
        "kind": "calculation",
        "citation": "Closed-form trace-over-plane evaluation of the declared fixture",
        "edition": null,
        "locator": "worked case",
        "note": "Fixture geometry is synthetic, not a layout."
      }
    }
  ],
  "counterexamples": [
    {
      "id": "cex-same-copper-area",
      "claim": "Two layouts with the same copper area have the same EMC behaviour.",
      "refutation": "Loop inductance depends on the current path length and return proximity, not copper area. Moving the decoupling capacitor multiplies the loop length and inductance while the copper area is unchanged.",
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "loop inductance",
        "note": null
      }
    }
  ],
  "known_traps": [
    {
      "id": "trap-same-copper-area",
      "trap": "Claiming EMC equivalence from equal copper area or from a missing stackup.",
      "why_shallow_fails": "Copper area does not determine return-loop inductance; the stackup height, trace width and placement distance do. Without a stackup the value is unavailable.",
      "guard": "Require stackup, trace width, placement distance and via length; return a typed unavailable loop inductance when stackup data is missing.",
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "return path",
        "note": null
      }
    }
  ]
