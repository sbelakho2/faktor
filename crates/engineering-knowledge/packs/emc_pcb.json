  "terminology": [
    {
      "id": "term-return-path",
      "term": "return path",
      "definition": "The conductor that carries the return current of a signal or power loop, ideally directly beneath the outgoing trace.",
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "return current",
        "note": null
      }
    },
    {
      "id": "term-creepage",
      "term": "creepage",
      "definition": "The shortest path along a solid insulating surface between two conductive parts.",
      "provenance": {
        "kind": "standard",
        "citation": "IEC 60664-1",
        "edition": null,
        "locator": "insulation coordination",
        "note": null
      }
    },
    {
      "id": "term-clearance",
      "term": "clearance",
      "definition": "The shortest air distance between two conductive parts.",
      "provenance": {
        "kind": "standard",
        "citation": "IEC 60664-1",
        "edition": null,
        "locator": "insulation coordination",
        "note": null
      }
    }
  ],
  "models": [
    {
      "id": "model-pcb-loop-inductance",
      "name": "Trace-over-plane loop inductance with decoupling placement and explicit spacing rules",
      "equation_ids": [
        "eq-loop-inductance",
        "eq-placement",
        "eq-loop-impedance",
        "eq-spacing"
      ],
      "assumption_ids": [
        "asm-trace-over-plane",
        "asm-rule-inputs",
        "asm-static-layout"
      ],
      "validity_domain_ids": [
        "val-return-path-geometry",
        "val-rule-inputs"
      ],
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering; IPC-2221B metadata",
        "edition": null,
        "locator": "loop inductance",
        "note": "The estimate is a low-frequency geometric model."
      }
    }
  ],
  "equations": [
    {
      "id": "eq-loop-inductance",
      "expression": "L_loop ~= mu0 h l / w",
      "dimensional_signature": "inductance",
      "variables": [
        {
          "symbol": "L_loop",
          "description": "loop inductance",
          "dimension": "M L^2 T^-2 I^-2"
        },
        {
          "symbol": "h",
          "description": "dielectric height from trace to return plane",
          "dimension": "L"
        },
        {
          "symbol": "l",
          "description": "loop length",
          "dimension": "L"
        },
        {
          "symbol": "w",
          "description": "trace width",
          "dimension": "L"
        }
      ],
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "trace over plane",
        "note": "Valid for l >> h and w >= h."
      }
    },
    {
      "id": "eq-placement",
      "expression": "l = 2 (d + l_via); L_loop(d) - L_loop(0) = mu0 h 2 d / w",
      "dimensional_signature": "inductance",
      "variables": [
        {
          "symbol": "d",
          "description": "decoupling capacitor distance from the load",
          "dimension": "L"
        },
        {
          "symbol": "l_via",
          "description": "via length",
          "dimension": "L"
        }
      ],
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "decoupling placement",
        "note": null
      }
    },
    {
      "id": "eq-loop-impedance",
      "expression": "Z_loop = 2 pi f L_loop",
      "dimensional_signature": "resistance",
      "variables": [
        {
          "symbol": "Z_loop",
          "description": "loop impedance magnitude",
          "dimension": "M L^2 T^-3 I^-2"
        }
      ],
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "loop impedance",
        "note": null
      }
    },
    {
      "id": "eq-spacing",
      "expression": "pass = actual_clearance >= rule_clearance && actual_creepage >= rule_creepage",
      "dimensional_signature": "dimensionless",
      "variables": [
        {
          "symbol": "actual",
          "description": "measured spacing",
          "dimension": "L"
        },
        {
          "symbol": "rule",
          "description": "project spacing rule",
          "dimension": "L"
        }
      ],
      "provenance": {
        "kind": "standard",
        "citation": "IEC 60664-1",
        "edition": null,
        "locator": "clearance and creepage",
        "note": "The rule values are supplied by the project; no standard table is embedded."
      }
    }
  ],
  "assumptions": [
    {
      "id": "asm-trace-over-plane",
      "statement": "The return current is directly below the trace and the loop inductance follows the parallel-plate trace-over-plane estimate.",
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "return path",
        "note": null
      }
