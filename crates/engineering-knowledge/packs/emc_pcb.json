  "design_rules": [
    {
      "id": "rule-decoupling-distance",
      "rule": "Place the decoupling capacitor so the return-loop inductance meets the target; loop inductance grows linearly with placement distance.",
      "check": "L_loop <= target at the actual placement",
      "severity": "required",
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "decoupling",
        "note": null
      }
    },
    {
      "id": "rule-spacing",
      "rule": "Check actual clearance and creepage against the project rules; a missing stackup/rule makes the check unavailable.",
      "check": "actual >= rule for both clearance and creepage",
      "severity": "required",
      "provenance": {
        "kind": "standard",
        "citation": "IEC 60664-1",
        "edition": null,
        "locator": "clearance and creepage",
        "note": null
      }
    }
  ],
  "manufacturing_rules": [
