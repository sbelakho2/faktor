    {
      "id": "asm-rule-inputs",
      "statement": "Clearance and creepage limits are explicit rule inputs with provenance; the model does not invent a standard table.",
      "provenance": {
        "kind": "engineering_practice",
        "citation": "Project EMC/PCB design rules",
        "edition": null,
        "locator": "spacing rules",
        "note": null
      }
    },
    {
      "id": "asm-static-layout",
      "statement": "The estimate is a low-frequency geometric loop estimate; via transitions, connector breakout and plane splits are not modeled.",
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "model limits",
        "note": null
      }
    }
  ],
  "validity_domains": [
    {
      "id": "val-return-path-geometry",
      "statement": "A revision-bound stackup with dielectric height and trace width is required; the trace width must be at least the dielectric height.",
      "temperature": null,
      "exclusions": [
        "missing stackup",
        "trace width below dielectric height",
        "plane split or connector breakout dominating the loop"
      ],
      "provenance": {
        "kind": "reference",
        "citation": "Ott, Electromagnetic Compatibility Engineering",
        "edition": null,
        "locator": "trace-over-plane validity",
        "note": null
      }
    },
    {
      "id": "val-rule-inputs",
      "statement": "Clearance and creepage checks require both the actual spacing and the project rule; missing either leaves the check unavailable.",
      "temperature": null,
      "exclusions": [
        "missing actual spacing",
        "missing rule value",
        "rule without provenance"
      ],
      "provenance": {
        "kind": "standard",
        "citation": "IEC 60664-1 metadata and project rules",
