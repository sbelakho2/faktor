  "worked_cases": [
    {
      "id": "case-basquin",
      "description": "A 300 MPa zero-mean stress amplitude on a curve with sigma_f' = 900 MPa and b = -0.1 has a finite Basquin life.",
      "inputs": [
        {
          "name": "stress_amplitude",
          "value": 300.0,
          "unit": "MPa",
          "note": null
        },
        {
          "name": "sigma_f_prime",
          "value": 900.0,
          "unit": "MPa",
          "note": null
        },
        {
          "name": "b",
          "value": -0.1,
          "unit": "1",
          "note": null
        },
        {
          "name": "cycles",
          "value": 1000.0,
          "unit": "1",
          "note": null
        }
      ],
      "expected": [
        {
          "name": "life_cycles",
          "value": 29524.5,
          "unit": "1",
          "tolerance": 1e-6,
          "note": "0.5 (300/900)^(1/-0.1)"
        },
        {
          "name": "damage",
          "value": 0.03387017,
          "unit": "1",
          "tolerance": 1e-8,
          "note": "1000/life"
        }
      ],
      "provenance": {
        "kind": "calculation",
        "citation": "Closed-form Basquin evaluation of the declared fixture",
        "edition": null,
        "locator": "worked case",
        "note": "Fixture coefficients are synthetic, not a test report."
      }
    }
  ],
  "counterexamples": [
    {
      "id": "cex-endurance-half-uts",
      "claim": "The endurance limit is always half the tensile strength.",
      "refutation": "A UTS fraction is not an S-N curve and carries no stress ratio, surface, environment or run-out definition. The model refuses when no curve covers the regime.",
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E466",
        "edition": null,
        "locator": "endurance limit",
        "note": null
      }
    }
  ],
  "known_traps": [
    {
      "id": "trap-sn-outside-regime",
      "trap": "Using a UTS fraction as an endurance limit or extrapolating an S-N curve above yield or beyond its fitted life.",
      "why_shallow_fails": "The arithmetic looks plausible but the stress/life point is outside the tested regime, so the curve has no authority there.",
      "guard": "Check yield, endurance limit, transition and fitted range; refuse or request a curve that covers the regime.",
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E466/E606",
        "edition": null,
        "locator": "validity",
        "note": null
      }
    }
