{
  "schema": "faktor.engineering.knowledge-pack/v1",
  "id": "fatigue-materials",
  "version": "1.0.0",
  "title": "S-N and strain-life fatigue with mean-stress correction and Miner damage",
  "domain": "fatigue",
  "provenance": {
    "kind": "reference",
    "citation": "ASTM E466 and E606 practices; Basquin (1910); Coffin-Manson; Shigley's Mechanical Engineering Design",
    "edition": null,
    "locator": "stress-life, strain-life and damage accumulation",
    "note": "Model structure only; curve coefficients and validity limits must come from revision-bound test data."
  },
  "terminology": [
    {
      "id": "term-sn-curve",
      "term": "S-N curve",
      "definition": "Stress-amplitude versus cycles-to-failure curve at a stated stress ratio, surface condition and environment.",
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E466",
        "edition": null,
        "locator": "constant-amplitude fatigue testing",
        "note": null
      }
    },
    {
      "id": "term-strain-life",
      "term": "strain-life curve",
      "definition": "Total-strain-amplitude versus reversals-to-failure relation separating elastic and plastic strain components.",
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E606",
        "edition": null,
        "locator": "strain-controlled fatigue testing",
        "note": null
      }
    },
    {
      "id": "term-miner-damage",
      "term": "Miner damage",
      "definition": "Linear accumulation of block damage as the sum of cycles divided by life at each block amplitude.",
      "provenance": {
        "kind": "reference",
        "citation": "Shigley's Mechanical Engineering Design",
        "edition": null,
        "locator": "cumulative damage",
        "note": null
      }
    }
  ],
  "models": [
    {
      "id": "model-fatigue-damage",
      "name": "Regime-checked Basquin/Coffin-Manson fatigue and Miner damage",
      "equation_ids": [
        "eq-goodman",
        "eq-basquin",
        "eq-coffin-manson",
        "eq-miner"
      ],
      "assumption_ids": [
        "asm-basquin-regime",
        "asm-strain-life-regime",
        "asm-miner-linear"
      ],
      "validity_domain_ids": [
        "val-sn-regime",
        "val-strain-life-regime"
      ],
      "provenance": {
        "kind": "reference",
        "citation": "ASTM E466/E606 and Shigley fatigue design",
        "edition": null,
        "locator": "fatigue life models",
        "note": "The model refuses rather than extrapolating outside the fitted curve."
      }
    }
  ],
  "equations": [
    {
      "id": "eq-goodman",
      "expression": "sigma_a,eq = sigma_a/(1 - sigma_m/UTS)",
      "dimensional_signature": "pressure",
      "variables": [
        {
          "symbol": "sigma_a",
          "description": "stress amplitude",
          "dimension": "M L^-1 T^-2"
        },
        {
          "symbol": "sigma_m",
          "description": "mean stress",
          "dimension": "M L^-1 T^-2"
        },
        {
          "symbol": "UTS",
          "description": "ultimate tensile strength",
          "dimension": "M L^-1 T^-2"
        }
      ],
      "provenance": {
        "kind": "reference",
        "citation": "Shigley's Mechanical Engineering Design",
        "edition": null,
        "locator": "mean-stress correction",
        "note": null
      }
    },
    {
      "id": "eq-basquin",
      "expression": "sigma_a,eq = sigma_f' (2 N_f)^b",
      "dimensional_signature": "pressure",
      "variables": [
        {
          "symbol": "sigma_f'",
          "description": "fatigue strength coefficient",
          "dimension": "M L^-1 T^-2"
        },
        {
          "symbol": "b",
          "description": "fatigue strength exponent",
          "dimension": "1"
        },
        {
          "symbol": "N_f",
          "description": "cycles to failure",
          "dimension": "1"
        }
      ],
      "provenance": {
        "kind": "reference",
        "citation": "Basquin, The exponential law of endurance tests (1910)",
        "edition": null,
        "locator": "stress-life relation",
        "note": null
      }
    },
    {
      "id": "eq-coffin-manson",
      "expression": "eps_a = (sigma_f'/E)(2N_f)^b + eps_f' (2N_f)^c",
      "dimensional_signature": "dimensionless strain",
      "variables": [
        {
          "symbol": "eps_a",
          "description": "total strain amplitude",
          "dimension": "1"
        },
        {
          "symbol": "eps_f'",
          "description": "fatigue ductility coefficient",
          "dimension": "1"
        },
        {
          "symbol": "c",
          "description": "fatigue ductility exponent",
          "dimension": "1"
        }
      ],
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E606",
        "edition": null,
        "locator": "strain-life relation",
        "note": null
      }
    },
    {
      "id": "eq-miner",
      "expression": "D = sum n_i/N_i",
      "dimensional_signature": "dimensionless",
      "variables": [
        {
          "symbol": "D",
          "description": "accumulated damage",
          "dimension": "1"
        },
        {
          "symbol": "n_i",
          "description": "applied cycles in block i",
          "dimension": "1"
        }
      ],
      "provenance": {
        "kind": "reference",
        "citation": "Shigley's Mechanical Engineering Design",
        "edition": null,
        "locator": "Miner rule",
        "note": null
      }
    }
  ],
  "assumptions": [
    {
      "id": "asm-basquin-regime",
      "statement": "The S-N branch applies below yield and above the declared endurance limit; stress above yield is refused rather than extrapolated.",
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E466",
        "edition": null,
        "locator": "stress-life validity",
        "note": null
      }
    },
    {
      "id": "asm-strain-life-regime",
      "statement": "The strain-life branch applies only up to the declared transition cycles and maximum total strain.",
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E606",
        "edition": null,
        "locator": "strain-life validity",
        "note": null
      }
    },
    {
      "id": "asm-miner-linear",
      "statement": "Block damage accumulates linearly; load-sequence interaction and mean-stress relaxation are outside the model.",
      "provenance": {
        "kind": "reference",
        "citation": "Shigley's Mechanical Engineering Design",
        "edition": null,
        "locator": "Miner rule",
        "note": null
      }
    }
  ],
  "validity_domains": [
    {
      "id": "val-sn-regime",
      "statement": "Stress amplitude must be between the endurance limit and the yield strength, with the stress ratio and surface condition represented by the supplied curve.",
      "temperature": null,
      "exclusions": [
        "stress above yield",
        "stress outside the fitted S-N range",
        "unmodeled surface or environmental effects"
      ],
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E466",
        "edition": null,
        "locator": "stress-life validity",
        "note": null
      }
    },
    {
      "id": "val-strain-life-regime",
      "statement": "Strain amplitude must be inside the fitted strain-life range and below the declared transition to the S-N regime.",
      "temperature": null,
      "exclusions": [
        "strain above the fitted maximum",
        "life beyond the transition cycles",
        "missing elastic modulus or curve coefficients"
      ],
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E606",
        "edition": null,
        "locator": "strain-life validity",
        "note": null
      }
    }
  ],
