  "design_rules": [
    {
      "id": "rule-refuse-outside-regime",
      "rule": "Refuse to extrapolate outside the fitted S-N or strain-life regime; do not use a UTS fraction as an endurance limit.",
      "check": "stress/strain and life inside the declared validity envelope",
      "severity": "required",
      "provenance": {
        "kind": "standard",
        "citation": "ASTM E466/E606",
        "edition": null,
        "locator": "validity",
        "note": null
      }
    },
    {
      "id": "rule-miner-sum",
      "rule": "Accumulate block damage linearly and report the result as a damage sum, not an averaged stress.",
      "check": "D = sum n_i/N_i",
      "severity": "required",
      "provenance": {
