# Packaging hygiene: the VSIX ships only what the extension runtime needs.
# Built JavaScript lives in out/ (see npm run build); sources are excluded.
src/**
harness/**
scripts/**
tsconfig.json
**/*.ts
**/*.js.map
node_modules/**
.vscodeignore
# The Faktor-owned chat panel lives under media/ (chat.js, chat.css,
# composer-state.js, faktor.svg) and ships verbatim; no vendored closure and
# no staging step exist. This explicit re-include survives any future
# widening of the ignore list above.
!media/**
