<idea-plugin>
    <id>dev.faktor.jetbrains</id>
    <name>Faktor</name>
    <version>0.1.0</version>
    <vendor>Faktor</vendor>

    <description><![CDATA[
        Faktor — an engineering agent for autonomous code investigation,
        implementation and verification inside your IDE.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Faktor"
                    anchor="right"
                    canCloseContents="true"
                    icon="/META-INF/faktor.svg"
                    factoryClass="dev.faktor.frontend.FaktorToolWindowFactory"/>
        <!-- I08: APPLICATION-level settings (the daemon binary path is
             application-scoped and must never be project-configurable).
             The `instance` attribute is the registration form the bundled
             2024.1 platform's ConfigurableEP supports. -->
        <applicationConfigurable id="dev.faktor.settings"
                                 instance="dev.faktor.frontend.FaktorConfigurable"/>
    </extensions>
</idea-plugin>
