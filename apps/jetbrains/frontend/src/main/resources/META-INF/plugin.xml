<idea-plugin>
    <id>dev.faktor.jetbrains</id>
    <name>Faktor</name>
    <version>0.1.0</version>
    <vendor>Faktor</vendor>

    <description><![CDATA[
        Faktor — an engineering agent for autonomous code investigation,
        implementation and verification inside your IDE.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Faktor"
                    anchor="right"
                    canCloseContents="true"
                    icon="/META-INF/faktor.svg"
                    factoryClass="dev.faktor.frontend.FaktorToolWindowFactory"/>
    </extensions>
</idea-plugin>
