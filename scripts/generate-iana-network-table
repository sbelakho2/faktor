#!/bin/sh
# Generate the static IANA longest-prefix-match address table in
# crates/security/src/network.rs from the pinned special-purpose registry
# CSVs in crates/security/data/.
#
# Provenance (frozen, operator-refreshed inputs only):
#   https://www.iana.org/assignments/iana-ipv4-special-registry/iana-ipv4-special-registry-1.csv
#   https://www.iana.org/assignments/iana-ipv6-special-registry/iana-ipv6-special-registry-1.csv
# Scripts/update-iana-special-registry.sh is the ONLY network-touching step;
# it refreshes the pinned CSVs and this generator turns them into the
# deterministic, byte-stable table between the generated markers.
#
# Usage:
#   ./scripts/generate-iana-network-table            # rewrite the table
#   ./scripts/generate-iana-network-table --check    # fail if it is stale
#
# The implementation is the Rust faktor-ci-tools `iana-table` command; it
# preserves the exact checked-in bytes and is verified by --check.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CI_TOOLS="${FAKTOR_CI_TOOLS:-}"
if [ -z "$CI_TOOLS" ]; then
    if [ -n "${CARGO_TARGET_DIR:-}" ]; then
        CI_TOOLS="$CARGO_TARGET_DIR/release/faktor-ci-tools"
    else
        CI_TOOLS="$ROOT/target/release/faktor-ci-tools"
    fi
fi
[ -x "$CI_TOOLS" ] || {
    echo "generate-iana-network-table: $CI_TOOLS is missing; build it with cargo build --release -p faktor-ci-tools" >&2
    exit 2
}
cd "$ROOT"
exec "$CI_TOOLS" iana-table "$@"
