      "note": "Null-vs-absent probe: the unmodified client serializes explicit nulls into the body (the daemon accepts them); the response divergence is the same rich-Session gap as session.create.",
      "request": {
        "body": "{\"metadata\":null,\"model\":{\"id\":\"m\",\"providerID\":\"fake\"},\"permission\":null,\"platform\":null,\"title\":\"wire trace nulls\"}",
        "content_type": "application/json",
        "method": "POST",
        "path": "/session",
        "query": ""
      },
      "response": {
        "body": {
          "createdMs": "@int",
