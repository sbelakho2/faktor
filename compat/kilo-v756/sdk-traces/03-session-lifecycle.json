      "sdk_requires": [],
      "sdk_type": "packages/sdk/js/src/v2/gen/types.gen.ts#SessionMessagesResponses.200 (Array<{info: Message, parts: Array<Part>}>)",
      "status": "passing"
    },
    {
      "args": {
        "model": {
          "modelID": "m",
          "providerID": "fake"
        },
        "parts": [
          {
            "synthetic": false,
            "text": "ping",
            "time": {
              "start": 0
            },
            "type": "text"
          }
