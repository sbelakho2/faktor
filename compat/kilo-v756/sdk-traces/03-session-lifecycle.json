        "content_type": "application/json",
        "event_stream": false,
        "status": 200
      },
      "sdk_requires": [
        "#array"
      ],
      "sdk_type": "packages/sdk/js/src/v2/gen/types.gen.ts#SessionListResponses.200 (Array<Session1>)",
      "status": "divergence"
    },
    {
